# =================================================================
# 🚀 AHMED PORTFOLIO - PRODUCTION ENVIRONMENT CONFIGURATION
# =================================================================

NODE_ENV=production
PORT=8080
HOST=0.0.0.0

# -----------------------------------------------------------------
# 🛡️ 1. SECURE ADMIN CREDENTIALS (Required for /api/contact/submissions)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# -----------------------------------------------------------------
ADMIN_SECRET=your_high_entropy_64_char_hex_secret_here
OWNER_EMAIL=ahmedmusthaffa02@gmail.com

# -----------------------------------------------------------------
# 🤖 2. CLOUDFLARE TURNSTILE BOT DEFENSE (Recommended)
# Get from: https://dash.cloudflare.com/?to=/:account/turnstile
# (Defaults to Cloudflare test secret if left unset)
# -----------------------------------------------------------------
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# -----------------------------------------------------------------
# ⚡ 3. UPSTASH SERVERLESS REDIS (Recommended for Edge Rate Limiting)
# Get 100% Free from: https://console.upstash.com/
# (Falls back to local memory if left unset)
# -----------------------------------------------------------------
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxxxxxxxxx=

# -----------------------------------------------------------------
# 💬 4. 100% FREE GMAIL SMTP (500 Free Emails / Day)
# Steps: Google Account -> Security -> Search 'App Passwords' -> Create
# -----------------------------------------------------------------
GMAIL_USER=ahmedmusthaffa02@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# -----------------------------------------------------------------
# 💬 5. 100% FREE RESEND API (3000 Free Emails / Month)
# -----------------------------------------------------------------
# RESEND_API_KEY=re_123456789

RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_MS=600000

